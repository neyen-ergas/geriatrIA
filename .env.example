# Copiar este archivo como .env.local y reemplazar los valores.
# Los valores reales cambian en cada instalación y no se guardan en Git.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# Clave service_role. Saltea RLS, así que nunca lleva el prefijo NEXT_PUBLIC_ ni
# se importa desde código que corra en el navegador. Solo la usan los Server
# Components y las Server Actions que leen la tabla `consulta`.
SUPABASE_SERVICE_ROLE_KEY=
